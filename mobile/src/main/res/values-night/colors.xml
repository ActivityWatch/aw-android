<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Do not override default_text_color here. Auth and Onboarding activities
         keep light chrome via applySafeWindowInsets(followNightMode = false);
         a night white text color would be unreadable on that background
         (aw-android#301 P1). SyncSettingsActivity uses followNightMode = true
         and therefore gets a dark background in night mode — its DayNight theme
         attributes resolve to white text automatically, so no override is
         needed here for that screen either. -->

    <!-- Widget theme colors (dark mode overrides) -->
    <color name="widget_background">#2A2A2A</color>
    <color name="widget_text_primary">#FFFFFF</color>
    <color name="widget_text_secondary">#AAAAAA</color>
    <color name="widget_text_tertiary">#CCCCCC</color>
    <color name="widget_text_muted">#888888</color>
    <color name="widget_bar_bg">#424242</color>
    <color name="widget_icon_tint">#888888</color>
</resources>